# Assignment 15 - File Handling

FILE_NAME = "students.txt"


def add_student():
    name = input("Enter student name: ")
    age = input("Enter student age: ")
    course = input("Enter student course: ")

    with open(FILE_NAME, "a") as file:
        file.write(f"{name},{age},{course}\n")

    print("Student added successfully!")


def read_students():
    try:
        with open(FILE_NAME, "r") as file:
            students = file.readlines()

        if students:
            print("\n--- Student Records ---")
            for student in students:
                name, age, course = student.strip().split(",")
                print("Name:", name)
                print("Age:", age)
                print("Course:", course)
                print("-------------------")
        else:
            print("No student records found.")

    except FileNotFoundError:
        print("No records found. Add a student first.")


def delete_student():
    name = input("Enter the name of the student to delete: ")
    
    try:
        with open(FILE_NAME, "r") as file:
            students = file.readlines()

        updated_students = []
        found = False

        for student in students:
            details = student.strip().split(",")

            if details[0].lower() == name.lower():
                found = True
            else:
                updated_students.append(student)

        with open(FILE_NAME, "w") as file:
            file.writelines(updated_students)

        if found:
            print("Student deleted successfully!")
        else:
            print("Student not found.")

    except FileNotFoundError:
        print("No student records found.")


while True:
    print("\n--- Student File Management ---")
    print("1. Add Student")
    print("2. Read Students")
    print("3. Delete Student")
    print("4. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        add_student()
    elif choice == "2":
        read_students()
    elif choice == "3":
        delete_student()
    elif choice == "4":
        print("Goodbye!")
        break
    else:
        print("Invalid choice. Try again.")